{
	"name": "Excel1",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Sheetnames": {
				"type": "array",
				"defaultValue": [
					"Orders",
					"Stores",
					"TaxRates"
				]
			}
		},
		"annotations": [],
		"type": "Excel",
		"typeProperties": {
			"sheetName": {
				"value": "@dataset().Sheetnames",
				"type": "Expression"
			},
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "retail_sales_dataset.xlsx",
				"container": "input"
			},
			"firstRowAsHeader": true
		},
		"schema": [
			{
				"name": "OrderID",
				"type": "String"
			},
			{
				"name": "StoreID",
				"type": "String"
			},
			{
				"name": "ProductID",
				"type": "String"
			},
			{
				"name": "Quantity",
				"type": "String"
			},
			{
				"name": "PricePerUnit",
				"type": "String"
			},
			{
				"name": "OrderDate",
				"type": "String"
			},
			{
				"name": "Status",
				"type": "String"
			}
		]
	}
}